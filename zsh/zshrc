# Container port of the host's ~/.zshrc. Paths and tool locations live in the
# Dockerfile's ENV so that they also apply outside interactive shells.
export ZSH="$HOME/.oh-my-zsh"

# The image is rebuilt rather than updated in place
zstyle ':omz:update' mode disabled

plugins=(git)

source $ZSH/oh-my-zsh.sh
eval "$(oh-my-posh init zsh)"

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

alias m='ninja -j1 -k1'
alias mm='ninja'
alias mmm='ninja -k999999'
alias ll='ls -lh'
alias la='ls -Ah'
alias l='ls -CFh'
alias gd='git diff --color -w'
alias gg='git status'
alias gl="git log --pretty=format:'%C(yellow)%h %Cred%ai %Cblue%an%Cgreen%d %Creset%s' --date=short"
alias glp="git log --pretty=format:'%C(yellow)%h %Cred%ai %Cblue%an%Cgreen%d %Creset%s' --date=short --first-parent"
alias gta="git log --pretty=format:'%C(yellow)%h %Cred%ai %Cblue%an%Cgreen%d %Creset%s' --date=short --graph --all"
alias gtc="git log --pretty=format:'%C(yellow)%h %Cred%ai %Cblue%an%Cgreen%d %Creset%s' --date=short --graph"
alias gco='git checkout'
alias venv-main="deactivate 2&> /dev/null; source ~/python-venvs/main/bin/activate"
alias pc="pre-commit run --all-files"

source ~/python-venvs/main/bin/activate
source <(fzf --zsh)

alias df='df -h'
alias du='du -h -c'

mcd() {
    mkdir "$@" && cd "$@"
}

extract() {
    if [ -f "$1" ] ; then
        case $1 in
            *.tar.bz2|*.tbz2) tar xjf "$1" ;;
            *.tar.gz|*.tgz)   tar xzf "$1" ;;
            *.tar)            tar xf "$1"  ;;
            *.bz2)            bunzip2 "$1" ;;
            *.gz)             gunzip "$1"  ;;
            *.zip)            unzip "$1"   ;;
            *)                echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}
